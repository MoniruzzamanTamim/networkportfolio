# ==========================================
# EMAILJS CONFIGURATION (CONTACT FORM)
# ==========================================
# EmailJS Dashboard Credentials
# Source: EmailJS Account Dashboard (https://dashboard.emailjs.com/)
# 
# এই তথ্যগুলো src/components/Contact.jsx (বা আপনার ব্যবহৃত কনট্যাক্ট ফরম) ফাইলে 
# ইমেইল পাঠানো এবং হ্যান্ডেল করার জন্য ব্যবহার করা হয়।
# আপনার EmailJS অ্যাকাউন্ট পরিবর্তন হলে নিচের কি (Keys) গুলো আপডেট করুন।

REACT_APP_EMAILJS_SERVICE_ID=service_pqsky2l
REACT_APP_EMAILJS_TEMPLATE_ID=template_pxujysg
REACT_APP_EMAILJS_PUBLIC_KEY=LIa5iYZAnxXEXp-by



# ==========================================
# REACT FRONTEND CONFIGURATION
# ==========================================
# Backend API Base URL
# Source: my-app/Server/server.js
# 
# এটি my-app/Server/server.js থেকে আসা এক্সপ্রেস (Express) ব্যাকএন্ডের মূল URL।
# এটি BdixSpeedTest.jsx এ fetch() এবং EventSource (SSE) কানেকশনের জন্য ব্যবহৃত হয়।
# Localhost বা পোর্ট (5000) পরিবর্তন হলে শুধু নিচের URL টি পরিবর্তন করুন।

REACT_APP_API_URL=http://localhost:5000


