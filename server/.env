# ==========================================
# NODE.JS EXPRESS BACKEND CONFIGURATION
# ==========================================

# Backend Server Listening Port
# server.js ফাইল এই পোর্টে সার্ভার রান করবে।
PORT=5000

# Client (React App) URL for CORS Permission
# server.js এ ব্রাউজারের CORS ব্লক এড়াতে এই URL-টি অনুমতি দেওয়া হয়।
CLIENT_URL=http://localhost:3000